{
  "name": "medicus",
  "private": true,
  "scripts": {
    "dev": "lessc --js ./styles/settings/theme.less ./styles/cutomized-antd.css && next dev",
    "build": "lessc --js ./styles/settings/theme.less ./styles/cutomized-antd.css && next build",
    "start": "lessc --js ./styles/settings/theme.less ./styles/cutomized-antd.css && next start",
    "start:dev": "lessc --js ./styles/settings/theme.less ./styles/cutomized-antd.css && next start -p 8080",
    "start:uat": "lessc --js ./styles/settings/theme.less ./styles/cutomized-antd.css && next start -p 8090",
    "lint": "next lint",
    "analyze": "cross-env ANALYZE=true next build",
    "codegen.yml": "graphql-codegen --config codegen.yml"
  },
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "antd": "^4.18.5",
    "clsx": "^1.1.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.10.7",
    "dayjs-plugin-utc": "^0.1.2",
    "env-cmd": "^10.1.0",
    "graphql": "^16.3.0",
    "next": "12.0.10",
    "react": "17.0.2",
    "react-aws-s3": "^1.5.0",
    "react-aws-s3-typescript": "^1.1.3",
    "react-dom": "17.0.2",
    "sass": "^1.49.4",
    "urql": "^2.1.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "2.6.2",
    "@graphql-codegen/introspection": "2.1.1",
    "@graphql-codegen/typescript": "^2.4.5",
    "@graphql-codegen/typescript-operations": "2.3.2",
    "@graphql-codegen/typescript-react-apollo": "3.2.8",
    "@graphql-codegen/typescript-urql": "^3.5.3",
    "@graphql-codegen/urql-introspection": "2.1.1",
    "@next/bundle-analyzer": "^12.0.10",
    "@stripe/react-stripe-js": "^1.7.0",
    "@stripe/stripe-js": "^1.23.0",
    "@types/node": "17.0.14",
    "@types/react": "17.0.38",
    "autoprefixer": "^10.4.2",
    "eslint": "8.8.0",
    "eslint-config-next": "12.0.10",
    "less": "^4.1.2",
    "less-loader": "^10.2.0",
    "postcss": "^8.4.6",
    "tailwindcss": "^3.0.18",
    "typescript": "4.5.5"
  }
}
